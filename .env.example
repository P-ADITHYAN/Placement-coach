# Copy this file to .env.local and fill in your own keys.
# Keys are server-side only — never add a NEXT_PUBLIC_ prefix to them.

# Groq powers speech-to-text and the AI participants: https://console.groq.com/keys
GROQ_API_KEY=

# Gemini is the fallback for the AI participants: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides (defaults shown).
# LLM_PROVIDER=groq            # or "gemini" to try Gemini first
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_STT_MODEL=whisper-large-v3-turbo
# GEMINI_MODEL=gemini-3.5-flash-lite
