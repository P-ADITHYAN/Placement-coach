# Copy this file to .env.local and fill in your own keys.
# Only NEXT_PUBLIC_ values are visible to the browser — never add that prefix to a secret.

# Supabase (Project Settings -> API Keys, and Project Settings -> Data API for the URL)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): server-only, used to save sessions and reports.
SUPABASE_SECRET_KEY=

# Groq powers speech-to-text and the AI participants: https://console.groq.com/keys
GROQ_API_KEY=

# Gemini is the fallback for the AI participants: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides (defaults shown).
# LLM_PROVIDER=groq            # or "gemini" to try Gemini first
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_STT_MODEL=whisper-large-v3-turbo
# GEMINI_MODEL=gemini-3.5-flash-lite
